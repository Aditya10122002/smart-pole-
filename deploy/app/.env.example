# App stack config — copy to ".env" next to docker-compose.yml on the board.
# (This .example file is safe to commit; the real .env is NOT.)

# Which backend image tag this board runs.
#   dev    = build from non-main branches
#   latest = production build from the main branch  ← requires fixes merged to main
VITALDATA_TAG=latest

# Optional app config (only if you uncomment the matching lines in the compose):
# HL7_ENABLED=false
# HL7_HIS_HOST=192.168.8.155
# HL7_HIS_PORT=2575
