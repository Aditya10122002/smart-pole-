# Tailscale config — copy to ".env" next to this compose on the board.
# The real .env holds a SECRET — never commit it.

# Tailscale auth key. Generate a REUSABLE key in the Tailscale admin console
# (Settings → Keys). A single-use key works only for the first boot; use a
# reusable (and ideally non-expiring or long-lived) key for field devices.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Hostname this board shows up as in your tailnet. Unique per board — convention
# is vitalschair-<board-serial>, e.g. vitalschair-15678868.
# MUST be a valid DNS label: letters, digits, hyphens only — NO SPACES.
# A space (e.g. "vitalschair-15678868 -IN") makes `tailscale up` fail with
# "not a valid DNS label" and the container restart-loops.
TS_HOSTNAME=vitalschair-CHANGEME
